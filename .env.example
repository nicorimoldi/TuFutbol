# Configuración de TuFutbol.
# make copia este archivo a .env la primera vez que se ejecuta (el .env no se sube al repo).
# Formato: VARIABLE=valor, sin espacios ni comillas.

# Base de datos PostgreSQL
POSTGRES_USER=tufutbol
POSTGRES_PASSWORD=tufutbol
POSTGRES_DB=tufutbol

# Puertos publicados en el host. Si alguno está ocupado, cambialo en .env.
DB_PORT=5432
API_PORT=8080
